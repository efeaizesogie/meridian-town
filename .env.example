# Copy to .env (git-ignored) and fill in what you need. The game server reads it at start.

# NEAR AI Cloud key: merchants decide with an LLM instead of the fixed strategy.
# Get one at https://cloud.near.ai (free credits via https://nearbuilders.org/join).
NEARAI_API_KEY=
# AGENT_LLM_MODEL=zai-org/GLM-5.1-FP8

# Optional: put a keyed RPC first if the free ones rate-limit you.
# NEAR_RPCS=https://near-testnet.drpc.org,https://testnet-rpc.intea.rs,https://test.rpc.fastnear.com

# Optional: the game account's key, instead of ~/.near-credentials/testnet/game.efecode.testnet.json
# GAME_PRIVATE_KEY=
